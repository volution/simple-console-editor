#!/dev/null




::// workspace / ...




<< workspace / initialize
	
	test "${#}" -eq 0
	
	"${ZRUN[@]}" ':: workspace / initialize / python'
!!




<< workspace / initialize / python
	
	test "${#}" -eq 0
	
	_outputs="$( exec -- "${ZRUN}" ':: workbench / outputs' )"
	test -d "${_outputs}"
	
	_sources="$( exec -- readlink -e -- ./sources )"
	
	_markers="${_outputs}/markers"
	
	for _folder in  "${_markers}" ; do
		if test ! -e "${_folder}" ; then
			mkdir -- "${_folder}"
		fi
	done
!!




--<< workbench / scratch
	
	test "${#}" -eq 0
	
	if test -e ./.scratch ; then
		_scratch="$( exec -- readlink -e -- ./.scratch )"
	elif test -h ./.scratch ; then
		_scratch="$( exec -- readlink -f -- ./.scratch )"
		mkdir -- "${_scratch}"
	elif test -e "${HOME}/go/.scratch" ; then
		_scratch="$( exec -- readlink -e -- "${HOME}/go/.scratch" )"
	elif test -e "${HOME}/.../volatile/workbench/go--scratch" ; then
		_scratch="$( exec -- readlink -e -- "${HOME}/.../volatile/workbench/go--scratch" )"
	else
		_scratch="${TMPDIR:-/tmp}/go--scratch--${UID}"
	fi
	
	_scratch="$( exec -- readlink -e -- "${_scratch}" )"
	
	printf -- '%s\n' "${_scratch}"
!!




--<< workbench / outputs
	
	test "${#}" -eq 0
	
	_outputs="${__OUTPUTS}"
	
	if test ! -e "${_outputs}" -o -h "${_outputs}" ; then
		
		_scratch="$( exec -- "${ZRUN}" ':: workbench / scratch' )"
		_outputs_store="${_scratch}/${UNAME_NODE}--${UNAME_FINGERPRINT}--${ZRUN_WORKSPACE_IDENTIFIER}"
		if test ! -d "${_outputs_store}" ; then
			mkdir -- "${_outputs_store}"
		fi
		_outputs_store="$( exec -- readlink -e -- "${_outputs_store}" )"
		
		ln -s -f -T -- "${_outputs_store}" "${_outputs}"
	fi
	
	test -d "${_outputs}"
	
	printf -- '%s\n' "${_outputs}"
!!




--<< workbench / publish
	
	_publish="${__PUBLISH}"
	test -d "${_publish}"
	
	printf -- '%s\n' "${_publish}"
!!




--<< workbench / python / *
	test "${#}" -eq 1 ; _python_version="${1}" ; shift -- 1
	
	_outputs="$( exec -- "${ZRUN}" ':: workbench / outputs' )"
	test -d "${_outputs}"
	
	case "${_python_version}" in
		
		( 2.7 )
			if test -e "${_outputs}/python/python2.7" ; then
				_python_executable="${_outputs}/python/python2.7"
			else
				_python_executable="$( type -P -- python2.7 )"
			fi
		;;
		
		( 3.* )
			if test "${_python_version}" == 3.x ; then
				_python_version='3'
			fi
			if test -e "${_outputs}/python/python${_python_version}" ; then
				_python_executable="${_outputs}/python/python${_python_version}"
			else
				_python_executable="$( type -P -- "python${_python_version}" )"
			fi
		;;
		
		( * )
			printf -- '[ee]  invalid python version `%s`;  aborting!\n' "${_python_version}" >&2
			exit -- 1
		;;
		
	esac
	
	test -x "${_python_executable}"
	_python_executable="$( exec -- readlink -e -- "${_python_executable}" )"
	
	_python_interpreter="python${_python_version}"
	
	printf -- '%s %s %s\n' \
			"${_python_version}" \
			"${_python_interpreter}" \
			"${_python_executable}" \
	#
!!


